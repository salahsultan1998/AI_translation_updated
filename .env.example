# Supabase 项目地址与公开的 anon/publishable key（不要使用 service_role key）
SUPABASE_URL=
SUPABASE_KEY=

# 开发时可设为 false 跳过登录；部署生产环境前改为 true。
LOCATOOL_AUTH_ENABLED=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.6-flash
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.6-flash

# 生产环境：使用 HTTPS，并把所有 Web 和 Worker 指向同一私有本地目录
LOCATOOL_STORAGE=./instance
LOCATOOL_SECURE_COOKIES=false
# 可选；多 Web 进程必须使用相同的稳定值。留空则在私有目录生成。
FLASK_SECRET_KEY=
